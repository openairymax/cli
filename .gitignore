# =============================================================================
# Airymax Console — .gitignore
# =============================================================================

# ---------- Rust 构建产物 ----------
target/
**/target/

# ---------- Rust 分析 ----------
*.rs.bk

# ---------- IDE 与编辑器配置 ----------
.vscode/
.idea/
.vs/
.trae/
*.code-workspace

# ---------- 构建目录 ----------
build/
build-*/

# ---------- 环境与密钥（禁止入库） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ---------- 运行时数据 ----------
*.log
*.sock
*.db
*.tmp
*.bak

# ---------- 操作系统文件 ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- 编辑器临时文件 ----------
*.swp
*.swo
*~

# Cargo.lock 入库以保证可复现构建
